  "pilot": {
    "id": "KIDS01",
    "title": "왕관보다 큰 집",
    "target_age_recommendation": [
      5,
      8
    ],
    "cast": [
      "D06",
      "D02",
      "D03"
    ],
    "status": "script_review",
    "duration_s": 150,
    "aspect_ratio": "16:9",
    "made_for_kids_intent": true,
    "premise": "왕관에 맞는 작은 집을 만들던 모더콜리가 친구들이 함께 쉴 수 있는 집을 만든다.",
    "scenes": [
      {
        "scene": 1,
        "start_s": 0,
        "end_s": 8,
        "duration_s": 8,
        "action": "거실 전경. 모더콜리가 바닥에 놓인 작은 종이 상자 위에 왕관을 살짝 얹고 뿌듯해한다.",
        "dialogue": "모더콜리: 오늘은 우리 집을 만들 거야!",
        "direction": "상자는 바닥에 고정. 캐릭터를 가두지 않는 열린 놀이 소품."
      },
      {
        "scene": 2,
        "start_s": 8,
        "end_s": 20,
        "duration_s": 12,
        "action": "왕관이 상자 꼭대기에 딱 맞는다. 모더콜리가 왕관을 다시 쓴다.",
        "dialogue": "모더콜리: 왕관도 딱 맞아. 아주 멋진 집이야.",
        "direction": "왕관 크기와 상자 크기를 한 화면에 보여 목표를 명확히 한다."
      },
      {
        "scene": 3,
        "start_s": 20,
        "end_s": 34,
        "duration_s": 14,
        "action": "불돔과 머스키가 작은 방석을 하나씩 들고 온다. 입구 앞에 나란히 놓자 입구가 전부 가려진다.",
        "dialogue": "불돔: 내 방석은 어디에 놓지? / 머스키: 내 것도 왔어.",
        "direction": "누군가의 몸을 웃음거리로 삼지 않는다. 문제는 방석과 집의 공간."
      },
      {
        "scene": 4,
        "start_s": 34,
        "end_s": 48,
        "duration_s": 14,
        "action": "모더콜리는 두 방석을 겹쳐 놓는다. 친구들이 앉으려다가 좁아 서로 눈을 마주친다.",
        "dialogue": "모더콜리: 위에 또 놓으면… / 불돔: 같이 앉을 자리가 없네.",
        "direction": "넘어지거나 추락하지 않고 바닥의 낮은 방석 두 장으로 연출."
      },
      {
        "scene": 5,
        "start_s": 48,
        "end_s": 58,
        "duration_s": 10,
        "action": "머스키가 자기 방석을 밖으로 옮긴다. 불돔도 옆에 놓는다. 모더콜리는 작은 집 안쪽과 친구들을 번갈아 본다.",
        "dialogue": "머스키: 여기서는 같이 앉을 수 있어.",
        "direction": "화면 방향을 유지해 안과 밖의 위치를 이해시킨다."
      },
      {
        "scene": 6,
        "start_s": 58,
        "end_s": 70,
        "duration_s": 12,
        "action": "모더콜리가 왕관을 만지다가 내려놓는다. 자기 방석도 친구들 쪽으로 가져온다.",
        "dialogue": "모더콜리: 왕관 말고… 우리한테 맞는 집을 만들까?",
        "direction": "대사의 뜻은 방석 세 장을 나란히 놓는 행동으로 보완."
      },
      {
        "scene": 7,
        "start_s": 70,
        "end_s": 86,
        "duration_s": 16,
        "action": "세 친구가 방석을 나란히 놓고 준비된 종이 벽 조각을 낮게 세운다. 정면이 활짝 열린 성 모양이다.",
        "dialogue": "불돔: 여기는 쉬는 자리. / 머스키: 여기는 같이 앉는 자리.",
        "direction": "미리 잘린 소품만 사용. 칼·가위 제작 절차나 머리 위 무거운 구조물 없음."
      },
      {
        "scene": 8,
        "start_s": 86,
        "end_s": 98,
        "duration_s": 12,
        "action": "모더콜리가 종이 문패를 가져온다. 세 친구의 발자국 그림이 들어 있다.",
        "dialogue": "모더콜리: 우리 셋의 집!",
        "direction": "글자를 읽지 못해도 발자국 세 개로 뜻이 전달되게 한다."
      },
      {
        "scene": 9,
        "start_s": 98,
        "end_s": 114,
        "duration_s": 16,
        "action": "셋이 나란히 앉아 본다. 불돔이 작은 장난감 곰을 바라본다. 셋이 조금씩 자리를 옮겨 곰 자리도 만든다.",
        "dialogue": "불돔: 친구가 하나 더 왔는데? / 머스키: 조금씩 옆으로 가자.",
        "direction": "같은 실패를 반복하지 않고 처음 배운 해결법을 새 상황에 적용."
      },
      {
        "scene": 10,
        "start_s": 114,
        "end_s": 128,
        "duration_s": 14,
        "action": "장난감 곰이 가운데 앉는다. 모더콜리가 자신의 왕관을 문패 위에 얹는다. 모두 집을 바라보며 웃는다.",
        "dialogue": "모더콜리: 이제 정말 딱 맞아.",
        "direction": "공유를 강요하기보다 함께 정한 공간 배치로 마무리."
      },
      {
        "scene": 11,
        "start_s": 128,
        "end_s": 140,
        "duration_s": 12,
        "action": "불돔이 편안히 눕는다. 모더콜리가 목소리를 낮추고 머스키가 고개를 끄덕인다.",
        "dialogue": "모더콜리: 우리 집 첫 번째 규칙. 쉬는 친구는… / 머스키: 조용히!",
        "direction": "소리를 갑자기 크게 내지 않는다. 짧은 대사 사이 표정 반응."
      },
      {
        "scene": 12,
        "start_s": 140,
        "end_s": 150,
        "duration_s": 10,
        "action": "불돔이 눈을 잠깐 뜨고 웃는다. 세 친구와 곰이 함께 보인다. 작은 사고멍치 로고로 끝난다.",
        "dialogue": "불돔: 그 규칙, 좋아.",
        "direction": "게임 설치·구매·댓글·알림 벨 요청 없음. 이야기 안에서 완결."
      }
    ],
    "short_duration_s": 25,
    "short": [
      {
        "start_s": 0,
        "end_s": 5,
        "action": "왕관이 작은 상자에 딱 맞는다. 모더콜리가 뿌듯해한다.",
        "dialogue": "왕관은 딱 맞는데…"
