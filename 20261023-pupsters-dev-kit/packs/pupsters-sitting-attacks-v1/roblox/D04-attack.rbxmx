    <Item class="Script" referent="RBX45">
      <Properties>
        <string name="Name">AttackPlayback</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source">-- Generated PUPSTERS sitting attack playback. No damage, targeting, or RemoteEvents.
local RunService = game:GetService("RunService")
local model = script.Parent
local attack = model:WaitForChild("Attack")
local AUTO_PREVIEW_DEFAULT = false
local DURATION = 2
