383,0.4297872,1,0},{0.6532517,1.0300594,-3.3320783,0,0,0.7071068,0.7071068,1.306383,0.4297872,1,0},{6.02e-05,0.3768679,-3.3320783,0,0,0,1,1.306383,0.4297872,1,0},{-0.6531313,1.0300594,-3.3320783,0,0,0.7071068,0.7071068,1.306383,0.4297872,1,0},{0.0001404,1.6985697,-3.3959081,0,0,0,1,1.3370213,0.412766,1,0},{0.6686511,1.030059,-3.3959081,0,0,0.7071068,0.7071068,1.3370213,0.412766,1,0},{0.0001404,0.3615484,-3.3959081,0,0,0,1,1.3370213,0.412766,1,0},{-0.6683702,1.030059,-3.3959081,0,0,0.7071068,0.7071068,1.3370213,0.412766,1,0},{0,0.035,2.0716049,0,0,0,1,3.7432099,1,0.12,0},{1.8716049,0.035,0.2,0,0.7071068,0,0.7071068,3.7432099,1,0.12,0},{0,0.035,-1.6716049,0,0,0,1,3.7432099,1,0.12,0},{-1.8716049,0.035,0.2,0,0.7071068,0,0.7071068,3.7432099,1,0.12,0}}},
}

if model:GetAttribute("AutoPreview") == nil then
	model:SetAttribute("AutoPreview", AUTO_PREVIEW_DEFAULT)
end

local parts = {}
for index, name in ipairs(names) do
	local part = model:FindFirstChild(name, true)
	assert(part and part:IsA("BasePart"), "Missing animated part: " .. name)
	parts[index] = part
end

local function frameCFrame(values)
	local x, y, z, w = values[4], values[5], values[6], values[7]
	return CFrame.new(values[1], values[2], values[3],
		1 - 2 * (y * y + z * z), 2 * (x * y - z * w), 2 * (x * z + y * w),
		2 * (x * y + z * w), 1 - 2 * (x * x + z * z), 2 * (y * z - x * w),
		2 * (x * z - y * w), 2 * (y * z + x * w), 1 - 2 * (x * x + y * y))
end

local heartbeatConnection
local attackConnection
local destroyingConnection
local playing = false
local destroyed = false

local function disconnectHeartbeat()
	if heartbeatConnection then
		heartbeatConnection:Disconnect()
		heartbeatConnection = nil
	end
end

local function play()
	if playing or destroyed then
		return
	end
	playing = true
	local reset = {}
	for index, part in ipairs(parts) do
		reset[index] = { cframe = part.CFrame, size = part.Size, transparency = part.Transparency }
	end
	local baseAnchor = frameCFrame(frames[1][2][anchorIndex])
	local placement = parts[anchorIndex].CFrame * baseAnchor:Inverse()
	local elapsed = 0
	local frameIndex = 1

	local function restore()
		for index, part in ipairs(parts) do
			local state = reset[index]
			if part.Parent then
				part.CFrame = state.cframe
				part.Size = state.size
				part.Transparency = state.transparency
			end
		end
	end

	heartbeatConnection = RunService.Heartbeat:Connect(function(dt)
		elapsed = math.min(elapsed + dt, DURATION)
		while frameIndex &lt; #frames - 1 and elapsed &gt;= frames[frameIndex + 1][1] do
			frameIndex += 1
		end
		local current = frames[frameIndex]
		local following = frames[math.min(frameIndex + 1, #frames)]
		local span = following[1] - current[1]
		local alpha = span &gt; 0 and math.clamp((elapsed - current[1]) / span, 0, 1) or 0
		for index, part in ipairs(parts) do
			local a, b = current[2][index], following[2][index]
			local currentCFrame = placement * frameCFrame(a)
			local nextCFrame = placement * frameCFrame(b)
			part.CFrame = currentCFrame:Lerp(nextCFrame, alpha)
			local currentSize = Vector3.new(baseSizes[index].X * a[8], baseSizes[index].Y * a[9], baseSizes[index].Z * a[10])
			local nextSize = Vector3.new(baseSizes[index].X * b[8], baseSizes[index].Y * b[9], baseSizes[index].Z * b[10])
			part.Size = currentSize:Lerp(nextSize, alpha)
			local visible = a[11] == 1
			part.Transparency = visible and 0 or 1
		end
		if elapsed &gt;= DURATION then
			disconnectHeartbeat()
			restore()
			playing = false
			if not destroyed and script.Parent:GetAttribute("AutoPreview") then
				task.delay(0.45, play)
			end
		end
	end)
end

attackConnection = attack.Event:Connect(play)
destroyingConnection = model.Destroying:Connect(function()
	destroyed = true
	disconnectHeartbeat()
	if attackConnection then attackConnection:Disconnect() end
	if destroyingConnection then destroyingConnection:Disconnect() end
end)

if script.Parent:GetAttribute("AutoPreview") then
	task.defer(play)
end

-- RELEASE_TIME is baked for gameplay integration metadata; this visual player applies no hit logic.</ProtectedString>
      </Properties>
    </Item>
  </Item>
</roblox>