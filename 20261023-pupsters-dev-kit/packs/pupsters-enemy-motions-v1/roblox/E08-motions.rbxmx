		{1.6,{{0.0030706,0.0009406,-0.5323886,0.0397476,0.00439,-0.1096905,0.993161,0.001,0.001,0.001,0.0},{0.0031383,0.0012421,-0.5323644,0.0397476,0.00439,-0.1096905,0.993161,0.001,0.001,0.001,0.0},{0.0031699,0.0014531,-0.5332253,0.0397476,0.00439,-0.1096905,0.993161,0.001,0.001,0.001,0.0},{0.0031656,0.0012938,-0.5314825,0.0397476,0.00439,-0.1096905,0.993161,0.001,0.001,0.001,0.0},{0.0022108,0.0016072,-0.5323352,0.0397476,0.00439,-0.1096905,0.993161,0.001,0.001,0.001,0.0},{0.0041334,0.0011786,-0.5323695,0.0397476,0.00439,-0.1096905,0.993161,0.001,0.001,0.001,0.0},{0.0019588,0.0009173,-0.5329623,0.0397476,0.00439,-0.1096905,0.993161,0.001,0.001,0.001,0.0},{0.0019588,0.0008262,-0.531826,0.0397476,0.00439,-0.1096905,0.993161,0.001,0.001,0.001,0.0},{0.0040472,0.0004518,-0.5329996,0.0397476,0.00439,-0.1096905,0.993161,0.001,0.001,0.001,0.0},{0.0040472,0.0003607,-0.5318633,0.0397476,0.00439,-0.1096905,0.993161,0.001,0.001,0.001,0.0},{0.0027536,0.0015696,-0.5333213,0.0397476,0.00439,-0.1096905,0.993161,0.001,0.001,0.001,0.0},{0.0035928,0.0013825,-0.5333363,0.0397476,0.00439,-0.1096905,0.993161,0.001,0.001,0.001,0.0},{0.0013963,0.0004348,-0.5335503,0.0715831,0.0221432,-0.2946894,0.9526509,0.001,0.001,0.001,0.0},{0.0047363,0.0004395,-0.5334503,0.0703869,-0.0256932,0.3419339,0.936732,0.001,0.001,0.001,0.0},{0.0030663,0.0004205,-0.5341603,0.073041,-0.0167173,0.2224792,0.9720538,0.001,0.001,0.001,0.0},{0.0013307,0.0005577,-0.53382,0.0715831,0.0221432,-0.2946894,0.9526509,0.001,0.001,0.001,0.0},{0.0014957,0.0004461,-0.5338369,0.0715831,0.0221432,-0.2946894,0.9526509,0.001,0.001,0.001,0.0},{0.0046404,0.0004411,-0.5337383,0.0703869,-0.0256932,0.3419339,0.936732,0.001,0.001,0.001,0.0},{0.0047934,0.0005685,-0.5337191,0.0703869,-0.0256932,0.3419339,0.936732,0.001,0.001,0.001,0.0},{0.0029632,0.0004468,-0.5344446,0.073041,-0.0167173,0.2224792,0.9720538,0.001,0.001,0.001,0.0},{0.0031433,0.0005328,-0.5344316,0.073041,-0.0167173,0.2224792,0.9720538,0.001,0.001,0.001,0.0}}},
	}},
}

if model:GetAttribute("AutoPreview") == nil then
	model:SetAttribute("AutoPreview", AUTO_PREVIEW_DEFAULT)
end

local parts = {}
for index, name in ipairs(names) do
	local part = model:FindFirstChild(name, true)
	assert(part and part:IsA("BasePart"), "Missing animated part: " .. name)
	parts[index] = part
end

local function frameCFrame(values)
	local x, y, z, w = values[4], values[5], values[6], values[7]
	return CFrame.new(values[1], values[2], values[3],
		1 - 2 * (y * y + z * z), 2 * (x * y - z * w), 2 * (x * z + y * w),
		2 * (x * y + z * w), 1 - 2 * (x * x + z * z), 2 * (y * z - x * w),
		2 * (x * z - y * w), 2 * (y * z + x * w), 1 - 2 * (x * x + y * y))
end

local localFrames = {}
for clipName, clip in pairs(clips) do
	local converted = {}
	for frameIndex, frame in ipairs(clip.frames) do
		local transforms = {}
		for partIndex, values in ipairs(frame[2]) do
			transforms[partIndex] = {frameCFrame(values), values}
		end
		converted[frameIndex] = {frame[1], transforms}
	end
	localFrames[clipName] = converted
end

local heartbeatConnection
local motionConnection
local destroyingConnection
local previewThread
local destroyed = false
local state = "Idle"
local activeClip = nil
local elapsed = 0
local resumeMove = false
local transitionFrom = nil
local transitionElapsed = 0

local function applyTransform(partIndex, a, b, alpha)
	local part = parts[partIndex]
	local placement = model:GetPivot()
	local targetCFrame = a[1]:Lerp(b[1], alpha)
	local av, bv = a[2], b[2]
	local sx = math.max(EPSILON_SIZE, baseSizes[partIndex].X * (av[8] + (bv[8] - av[8]) * alpha))
	local sy = math.max(EPSILON_SIZE, baseSizes[partIndex].Y * (av[9] + (bv[9] - av[9]) * alpha))
	local sz = math.max(EPSILON_SIZE, baseSizes[partIndex].Z * (av[10] + (bv[10] - av[10]) * alpha))
	local targetSize = Vector3.new(sx, sy, sz)
	local targetTransparency = av[11] == 1 and (1 - baseOpacities[partIndex]) or 1
	if transitionFrom then
		local blend = math.clamp(transitionElapsed / TRANSITION_DURATION, 0, 1)
		local previous = transitionFrom[partIndex]
		part.CFrame = placement * previous[1]:Lerp(targetCFrame, blend)
		part.Size = previous[2]:Lerp(targetSize, blend)
		part.Transparency = previous[3] + (targetTransparency - previous[3]) * blend
	else
		part.CFrame = placement * targetCFrame
		part.Size = targetSize
		part.Transparency = targetTransparency
	end
end

local function applyFrame(clipName, frameIndex)
	local frame = localFrames[clipName][frameIndex]
	for partIndex, transform in ipairs(frame[2]) do
		applyTransform(partIndex, transform, transform, 0)
	end
end

local function restoreRest()
	applyFrame("move", 1)
end

local function startClip(clipName, blendFromCurrent)
	if blendFromCurrent then
		local placement = model:GetPivot()
		transitionFrom = {}
		for partIndex, part in ipairs(parts) do
			transitionFrom[partIndex] = {placement:ToObjectSpace(part.CFrame), part.Size, part.Transparency}
		end
		transitionElapsed = 0
	else
		transitionFrom = nil
	end
	activeClip = clipName
	elapsed = 0
	state = clipName == "move" and "Move" or clipName == "hit" and "Hit" or "Death"
	if not blendFromCurrent then applyFrame(clipName, 1) end
end

local function reset()
	activeClip = nil
	elapsed = 0
	resumeMove = false
	transitionFrom = nil
	state = "Idle"
	restoreRest()
end

local function command(value)
	if destroyed or type(value) ~= "string" then return end
	local requested = string.lower(value)
	if requested == "reset" then
		reset()
		return
	end
	if state == "Death" or state == "Dead" then return end
	if requested == "move" then
		if state ~= "Move" then resumeMove = false; startClip("move", false) end
	elseif requested == "hit" then
		resumeMove = state == "Move" or resumeMove
		startClip("hit", true)
	elseif requested == "death" then
		resumeMove = false
		startClip("death", true)
	elseif requested == "stop" then
		activeClip = nil
		resumeMove = false
		transitionFrom = nil
		state = "Stopped"
		restoreRest()
	end
end

heartbeatConnection = RunService.Heartbeat:Connect(function(dt)
	if destroyed or not activeClip then return end
	local clipName = activeClip
	local clip = clips[clipName]
	elapsed += dt
	if transitionFrom then transitionElapsed += dt end
	if clip.looped then elapsed %= clip.duration else elapsed = math.min(elapsed, clip.duration) end
	local frames = localFrames[clipName]
	local frameIndex = math.min(math.floor(elapsed * 30) + 1, #frames)
	local followingIndex = math.min(frameIndex + 1, #frames)
	local current, following = frames[frameIndex], frames[followingIndex]
	local span = following[1] - current[1]
	local alpha = span &gt; 0 and math.clamp((elapsed - current[1]) / span, 0, 1) or 0
	for partIndex, a in ipairs(current[2]) do
		applyTransform(partIndex, a, following[2][partIndex], alpha)
	end
	if transitionFrom and transitionElapsed &gt;= TRANSITION_DURATION then transitionFrom = nil end
	if not clip.looped and elapsed &gt;= clip.duration then
		if clipName == "death" then
			activeClip = nil
			state = "Dead"
		elseif clipName == "hit" and resumeMove then
			resumeMove = false
			startClip("move", false)
		else
			activeClip = nil
			state = "Idle"
			restoreRest()
		end
	end
end)

motionConnection = motion.Event:Connect(command)
destroyingConnection = model.Destroying:Connect(function()
	destroyed = true
	if heartbeatConnection then heartbeatConnection:Disconnect() end
	if motionConnection then motionConnection:Disconnect() end
	if destroyingConnection then destroyingConnection:Disconnect() end
	if previewThread then task.cancel(previewThread) end
end)

if model:GetAttribute("AutoPreview") then
	previewThread = task.spawn(function()
		while not destroyed do
			command("Reset"); command("Move"); task.wait(1.8)
			command("Hit"); task.wait(0.9)
			command("Move"); task.wait(1.8)
			command("Death"); task.wait(2.0)
			command("Reset"); task.wait(0.8)
		end
	end)
end
</ProtectedString>
      </Properties>
    </Item>
  </Item>
</roblox>